apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: autosys-resource-reader-policy
spec:
  rules:
    - name: generate-autosys-resource-reader-rolebinding
      match:
        any:
          - resources:
              kinds:
                - ServiceAccount
              names:
                - "*-sa"

      generate:
        generateExisting: true
        synchronize: true

        apiVersion: rbac.authorization.k8s.io/v1
        kind: RoleBinding

        name: autosys-resource-reader-rolebinding
        namespace: "{{request.object.metadata.namespace}}"

        data:
          subjects:
            - kind: ServiceAccount
              name: "{{request.object.metadata.name}}"
              namespace: "{{request.object.metadata.namespace}}"

          roleRef:
            kind: ClusterRole
            name: autosys-resource-reader-clusterrole
            apiGroup: rbac.authorization.k8s.io
