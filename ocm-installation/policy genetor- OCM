apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: autosys-resource-reader-policy
  namespace: default
spec:
  remediationAction: enforce
  disabled: false

  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: autosys-resource-reader-clusterrole-policy
        spec:
          remediationAction: enforce
          severity: medium

          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: rbac.authorization.k8s.io/v1
                kind: ClusterRole
                metadata:
                  name: autosys-resource-reader-clusterrole
                rules:
                  - apiGroups:
                      - ""
                    resources:
                      - configmaps
                    resourceNames:
                      - argocd-cmd-params-cm
                    verbs:
                      - get

                  - apiGroups:
                      - ""
                    resources:
                      - secrets
                    resourceNames:
                      - rook-ceph-config
                    verbs:
                      - get

---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: binding-autosys-resource-reader-policy
  namespace: default

placementRef:
  name: placement-autosys-resource-reader
  kind: Placement
  apiGroup: cluster.open-cluster-management.io

subjects:
  - name: autosys-resource-reader-policy
    kind: Policy
    apiGroup: policy.open-cluster-management.io

---
apiVersion: cluster.open-cluster-management.io/v1beta1
kind: Placement
metadata:
  name: placement-autosys-resource-reader
  namespace: default

spec:
  predicates:
    - requiredClusterSelector:
        labelSelector:
          matchExpressions: []

